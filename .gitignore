# ──────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg

# ──────────────────────────────────────────────
# Large progress/state files (scraper state)
# ──────────────────────────────────────────────
scraped_data_global_2020_2026/progress_*.json

# ──────────────────────────────────────────────
# Large consolidated files exceeding GitHub limits / recommended sizes
